# DEV-ONLY defaults — easy credentials for local development.
# Usage:  cp .env.dev.example .env && docker compose up -d --build app postgres redis rabbitmq
#
# NEVER use these values for staging/production. For real deployments copy
# .env.example instead and generate strong secrets (openssl rand -base64 48).
#
# GOTCHA — "password authentication failed for user postgres":
# POSTGRES_PASSWORD only applies when the postgres-data volume is FIRST created.
# If a volume already exists from an earlier run with a different password,
# either reset dev data:   docker compose down && docker volume rm zbr_postgres-data
# or keep it and re-align:  docker compose exec postgres psql -U postgres \
#                             -c "ALTER USER postgres PASSWORD 'devpass';"

# --- Profile ---
# Runs the "docker" profile ALONE: Swagger UI on, readable error messages,
# relaxed Flyway, and the seeded demo logins stay usable. Compose otherwise
# defaults to "docker,prod", which turns all of that off. Local work only.
SPRING_PROFILES_ACTIVE=docker

# --- Required by docker-compose (it refuses to start without these) ---
# >=32 chars and not the banned sample value, so JwtService accepts it. Local only.
JWT_SECRET=dev-only-jwt-secret-not-for-prod-change-me-0123456789
DB_PASSWORD=devpass
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=devpass
GRAFANA_PASSWORD=devpass

# --- Dev conveniences ---
SMS_ENABLED=false
# Local dev: "*" disables CORS enforcement (any origin/port works). The docker
# profile defaults to this anyway; set explicit domains only for a real deploy.
CORS_ORIGINS=*

# --- Optional (leave blank in dev; payment webhook fails closed without them) ---
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=
