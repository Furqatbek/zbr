# DEV-ONLY defaults — easy credentials for local development.
# Usage:  cp .env.dev.example .env && docker compose up -d --build app postgres redis rabbitmq
#
# NEVER use these values for staging/production. For real deployments copy
# .env.example instead and generate strong secrets (openssl rand -base64 48).

# --- Required by docker-compose (it refuses to start without these) ---
# >=32 chars and not the banned sample value, so JwtService accepts it. Local only.
JWT_SECRET=dev-only-jwt-secret-not-for-prod-change-me-0123456789
DB_PASSWORD=devpass
RABBITMQ_USER=dev
RABBITMQ_PASSWORD=devpass
GRAFANA_PASSWORD=devpass

# --- Dev conveniences ---
SMS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Optional (leave blank in dev; payment webhook fails closed without them) ---
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=
