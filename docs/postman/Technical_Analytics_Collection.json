              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2024-01-01T00:00:00\",\n  \"endDate\": \"2024-01-01T23:59:59\",\n  \"includeHourlyDistribution\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/technical/websocket",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "technical", "websocket"]
            },
            "description": "Get WebSocket connection and message delivery metrics"
          }
        },
        {
          "name": "Get Real-time WebSocket Metrics",
          "request": {
            "method": "GET",
