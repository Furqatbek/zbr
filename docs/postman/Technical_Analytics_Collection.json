                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2024-01-01T00:00:00\",\n  \"endDate\": \"2024-01-01T23:59:59\",\n  \"includeDailyTrend\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/technical/storage",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "technical", "storage"]
