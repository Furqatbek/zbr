        {
          "name": "Get Storage Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/technical/storage/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "technical", "storage", "summary"]
            },
            "description": "Get current storage totals"
          }
        }
      ]
    }
  ]
}
