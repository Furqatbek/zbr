# Copy to .env and fill in real values. docker-compose refuses to start if any
# required secret is unset. NEVER commit the real .env.
#
# Deployment walkthrough: docs/DEPLOYMENT.md
# Launch runbook:         docs/GO_LIVE.md

# --- Required secrets (no defaults; compose errors if unset) ---
# Generate JWT_SECRET with:  openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
GRAFANA_PASSWORD=

# --- Public URLs ---
# MUST be your real public URL in production. Left at the default, every image
# URL handed to the mobile apps points at localhost and no photo loads.
IMAGE_BASE_URL=https://api.zbrr.uz/api/v1/images

# --- CORS: comma-separated origins. Set real domains in production. ---
# Patterns are supported (e.g. https://*.example.com); "*" disables enforcement
# and must NOT be used in production.
CORS_ORIGINS=https://zbrr.uz,https://www.zbrr.uz

# --- SMS (OTP login only — never used for notifications) ---
# Without valid credentials no OTP is delivered and nobody can log in.
SMS_ENABLED=true
SMS_PROVIDER=ESKIZ
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546
# SMS_ESKIZ_CALLBACK_URL=https://api.zbrr.uz/api/v1/sms/callback/eskiz
# Optional second provider used if the primary fails:
# SMS_FALLBACK_ENABLED=false
# SMS_FALLBACK_PROVIDER=DEVSMS
# SMS_DEVSMS_ENABLED=false
# SMS_DEVSMS_TOKEN=

# --- App-store review test number (docs/GO_LIVE.md) -------------------------
# For these EXACT numbers, request-otp succeeds WITHOUT sending an SMS and
# verify-otp accepts OTP_REVIEW_CODE — reviewers cannot receive our SMS.
# BOTH must be set or the feature stays off. CLEAR THESE ONCE REVIEW PASSES.
# OTP_REVIEW_NUMBERS=+998900000000
# OTP_REVIEW_CODE=123456

# --- Push notifications (docs/PUSH_DELIVERY.md) -----------------------------
# Android (FCM). The service-account key is a SECRET — NOT google-services.json.
#   base64 -w0 firebase-service-account.json
# WARNING: FIREBASE_ENABLED=true without a valid credential stops the app booting.
FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS_BASE64=
# ...or mount the file into ./secrets/ instead:
# FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase-service-account.json

# iOS (APNs). One .p8 serves all apps; each app sends its own bundle id at
# device-token registration, which becomes the apns-topic.
#   base64 -w0 AuthKey_ABC123XYZ9.p8
APNS_ENABLED=false
# APNS_KEY_BASE64=
# APNS_KEY_FILE=/run/secrets/apns_auth_key.p8
# APNS_KEY_ID=ABC123XYZ9
# APNS_TEAM_ID=VQ56W9S7S9
# APNS_TOPIC=com.zbr.owner
# APNS_PRODUCTION must match the installed build, or Apple returns
# 400 BadDeviceToken and the token is pruned:
#   false = Xcode/development builds   true = TestFlight/App Store
APNS_PRODUCTION=false

# --- Database backups (postgres-backup service; docs/BACKUP_RESTORE.md) ---
# Copy dumps OFF-HOST and ENCRYPTED — on-box backups die with the box.
# BACKUP_KEEP_DAYS=7            # days of dumps to retain
# BACKUP_INTERVAL_SECONDS=86400 # seconds between backups (default daily)

# --- Email (password-reset and welcome mail) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Auth / OTP tuning (defaults shown) ---
# JWT_ACCESS_EXPIRATION=900000      # 15 min, ms
# JWT_REFRESH_EXPIRATION=604800000  # 7 days, ms
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=3
# RATE_LIMIT_RPM=60
# RATE_LIMIT_BURST=10

# --- Order lifecycle (defaults shown) ---
# ORDER_AUTOCOMPLETE_MINUTES=60          # DELIVERED -> COMPLETED grace period
# ORDER_NO_COURIER_TIMEOUT_MINUTES=30    # READY with no courier -> cancel+refund

# --- Push tuning (defaults shown) ---
# PUSH_ENABLED=true
# PUSH_ANDROID_CHANNEL_ID must match the channel the Android apps create, or
# notifications arrive silently (no sound, no heads-up).
# PUSH_ANDROID_CHANNEL_ID=orders_v2
# PUSH_ANDROID_SOUND=new_order
# Expo transport (for apps still registering ExponentPushToken[...]):
# EXPO_PUSH_ENABLED=true
# EXPO_ACCESS_TOKEN=

# --- Payment (webhook fails closed unless set) ---
# No card acquiring in the MVP — the platform is cash-only until one is wired.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# --- Optional ---
# RESTOS_ENABLED=true
# RESTOS_ALLOWED_HOSTS=restos.example.com
# NOTIFICATION_ENABLED=true
# Delivery fees: the DB settings (admin API) win over these env defaults.
# DELIVERY_BASE_FEE=2.00
# DELIVERY_PER_KM_FEE=0.50
# DELIVERY_MIN_FEE=2.00
# DELIVERY_MAX_FEE=15.00
# Point routing at a SELF-HOSTED OSRM in production (default is a public demo
# server: rate-limited, and it sees customer coordinates).
# DELIVERY_ROUTING_ENABLED=true
# DELIVERY_ROUTING_OSRM_URL=https://osrm.your-domain.com
