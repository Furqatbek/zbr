# Copy to .env and fill in real values. docker-compose refuses to start if any
# required secret is unset. NEVER commit the real .env.

# --- Required secrets (no defaults; compose errors if unset) ---
# Generate JWT_SECRET with:  openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
GRAFANA_PASSWORD=

# --- Payment (required for the payment webhook to accept calls) ---
# The webhook fails closed unless this is set to a strong, non-placeholder value.
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_KEY=

# --- CORS: comma-separated exact origins (no wildcard with credentials) ---
CORS_ORIGINS=https://app.example.com

# --- Optional ---
# RESTOS_ALLOWED_HOSTS=restos.example.com
# SMS_ENABLED=false
