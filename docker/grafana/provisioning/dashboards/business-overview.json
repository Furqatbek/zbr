    {
      "type": "table",
      "title": "Top Restaurants",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.name AS restaurant, count(*) AS orders, COALESCE(sum(o.total),0) AS revenue FROM orders o JOIN restaurants r ON r.id = o.restaurant_id WHERE $__timeFilter(o.created_at) GROUP BY r.name ORDER BY orders DESC LIMIT 10",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "timeseries",
      "title": "Avg Fulfillment Time",
      "description": "Created -> delivered, minutes",
      "gridPos": {
        "x": 14,
        "y": 22,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(delivered_at, $__interval), avg(extract(epoch FROM (delivered_at - created_at)) / 60) AS \"avg minutes\" FROM orders WHERE $__timeFilter(delivered_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
