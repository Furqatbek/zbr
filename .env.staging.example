# Copy to .env.staging. Used ONLY by docker-compose.staging.yml.
#
#   cp .env.staging.example .env.staging
#   ./scripts/staging/init-staging.sh you@zbrr.uz
#
# Staging shares a host and an nginx with production and NOTHING else — separate
# database, Redis, RabbitMQ, volumes and secrets.

# --- Required. MUST DIFFER FROM PRODUCTION -------------------------------
# Reusing production's JWT_SECRET would make a token minted on staging valid
# against production. init-staging.sh refuses to run if they match.
#   openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=
RABBITMQ_USER=staging
RABBITMQ_PASSWORD=

# --- Token lifetime ------------------------------------------------------
# 60 seconds, on purpose: this is what lets the app teams exercise the refresh
# flow in two minutes instead of waiting an hour. Raise it if you are testing
# something else and the churn gets in the way.
JWT_ACCESS_EXPIRATION=60000
# JWT_REFRESH_EXPIRATION=604800000

# --- Login without SMS ---------------------------------------------------
# SMS is off so staging spends no Eskiz credit and never texts a real person.
# These numbers log in with OTP_REVIEW_CODE and no SMS is sent. Add one per
# tester so they are not fighting over a single account.
SMS_ENABLED=false
OTP_REVIEW_NUMBERS=+998900000000,+998900000001,+998900000002
OTP_REVIEW_CODE=123456

# --- Public URL ----------------------------------------------------------
IMAGE_BASE_URL=https://staging.zbrr.uz/api/v1/images
# Wide open here so the app teams can point a web build at it from anywhere.
# Safe because allow-credentials is false; never do this in production.
CORS_ORIGINS=*

# --- Profile -------------------------------------------------------------
# "docker" WITHOUT "prod": Swagger on, real error messages, seeded demo accounts
# usable. That is what makes staging worth having.
SPRING_PROFILES_ACTIVE=docker

# --- Host ports (loopback only; must not collide with production) --------
# STAGING_APP_HOST_PORT=8090
# STAGING_DB_HOST_PORT=5442
# STAGING_RABBITMQ_UI_HOST_PORT=15682

APP_TIMEZONE=Asia/Tashkent
APP_CURRENCY=UZS
